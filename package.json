{
  "name": "spitaltarife",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "import:check": "python3 scripts/import_catalog.py --check",
    "convert:private": "python3 scripts/convert_main_catalogs.py",
    "convert:check": "python3 scripts/convert_main_catalogs.py --check",
    "test:native": "node tests/native-firefox.mjs"
  }
}
